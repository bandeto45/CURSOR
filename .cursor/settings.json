{
  "version": "1.0",
  "project": {
    "name": "TBD",
    "description": "Reusable AI-agnostic setup (Claude, Kimi, Grok, Gemini, Copilot, Cursor…) — Ask → Recommend → Decide → Write → Confirm."
  },
  "agents": {
    "enabled": true,
    "directory": ".cursor/agents"
  },
  "commands": {
    "enabled": true,
    "directory": ".cursor/commands"
  },
  "hooks": {
    "enabled": true,
    "pre_commit": ".cursor/hooks/pre-commit.sh",
    "post_tool_use": ".cursor/hooks/lint-on-save.sh"
  },
  "rules": {
    "enabled": true,
    "directory": ".cursor/rules",
    "lockedDefaults": [
      "restrictions.mdc",
      "format.mdc",
      "multi-ai.mdc",
      "references.mdc",
      "design-direction.mdc",
      "layout-strategy.mdc",
      "ui-styling.mdc",
      "forms.mdc",
      "icons-states.mdc",
      "validation.mdc",
      "database.mdc",
      "implementation-phases.mdc",
      "proposal.mdc"
    ],
    "autoApply": {
      "restrictions.mdc": [
        "**/*"
      ],
      "format.mdc": [
        "**/*"
      ],
      "multi-ai.mdc": [
        "**/*"
      ],
      "references.mdc": [
        "**/*"
      ],
      "design-direction.mdc": [
        "**/*"
      ],
      "layout-strategy.mdc": [
        "**/*"
      ],
      "ui-styling.mdc": [
        "**/*"
      ],
      "forms.mdc": [
        "**/*"
      ],
      "icons-states.mdc": [
        "**/*"
      ],
      "validation.mdc": [
        "**/*"
      ],
      "database.mdc": [
        "**/*"
      ],
      "implementation-phases.mdc": [
        "**/*"
      ],
      "concept-domain.mdc": [
        "**/*"
      ],
      "route-layouts.mdc": [
        "**/*"
      ],
      "phase-plan.mdc": [
        "**/*"
      ],
      "backend.mdc": [
        "api/**",
        "server/**",
        "backend/**",
        "**/*.php"
      ],
      "security.mdc": [
        "api/**",
        "server/**",
        "backend/**",
        "**/*.php",
        "**/services/**"
      ],
      "testing.mdc": [
        "**/*.{test,spec}.{js,jsx,ts,tsx}",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "seo.mdc": [
        "**/*.{jsx,tsx,js,ts,html,php}",
        "**/seo/**",
        "**/meta/**"
      ],
      "proposal.mdc": [
        "**/*"
      ],
      "project-structure.mdc": [
        "**/*.{jsx,tsx,js,ts,vue,html,css}"
      ],
      "ui-components.mdc": [
        "**/*.{jsx,tsx,js,ts,vue,html,css}"
      ]
    },
    "projectFiles": [
      "concept-domain.mdc",
      "route-layouts.mdc",
      "phase-plan.mdc"
    ]
  },
  "skills": {
    "enabled": true,
    "directory": ".cursor/skills"
  },
  "behavior": {
    "alwaysReadClaudeMd": true,
    "claudeMdPath": "CURSOR.md",
    "aiAgnostic": true,
    "multiAiHandoffLog": true,
    "pointerFiles": [
      "AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md",
      ".github/copilot-instructions.md",
      ".windsurfrules"
    ],
    "preferEditOverCreate": true,
    "confirmDestructiveActions": true,
    "autoRunLintOnSave": true,
    "verbosity": "concise",
    "requireProjectIntake": true,
    "installMeansAskAndFill": true,
    "blockFeatureWorkUntilProfileFilled": true,
    "neverRemoveDefaultRules": true,
    "conceptDrivesDomainAndSchema": true,
    "referencesLeaveNoTraceInFiles": true,
    "decisionFlow": "ask-recommend-decide-write-confirm",
    "aiRecommends": true,
    "requireRouteLayouts": true,
    "layoutStrategyOptions": [
      "normal",
      "layout",
      "auto"
    ],
    "frontendFlavors": [
      "react",
      "native"
    ],
    "surfaces": [
      "web",
      "mobile",
      "web + mobile"
    ],
    "webPlusMobileLayout": "layout",
    "proposalPageSize": "letter",
    "proposalPackageInP1": true
  },
  "seo": {
    "enabled": false,
    "schemaOrg": true
  },
  "ignore": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "vendor/**",
    "*.lock",
    ".env",
    ".env.*",
    "!.env.example",
    "!.cursor/templates/**"
  ],
  "templates": {
    "enabled": true,
    "directory": ".cursor/templates",
    "items": [
      "deck-native/index.html",
      "deck-react/",
      "proposal-doc/proposal.html",
      "guide/GUIDE.md"
    ]
  }
}
