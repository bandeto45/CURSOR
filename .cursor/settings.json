{
  "version": "1.0",
  "project": {
    "name": "TBD",
    "description": "Reusable AI-agnostic setup (Claude, Kimi, Grok, Gemini, Copilot, Cursor…) — Ask → Recommend → Decide → Write → Confirm."
  },
  "agents": {
    "enabled": true,
    "directory": ".cursor/agents"
  },
  "commands": {
    "enabled": true,
    "directory": ".cursor/commands"
  },
  "hooks": {
    "enabled": true,
    "pre_commit": ".cursor/hooks/pre-commit.sh",
    "post_tool_use": ".cursor/hooks/lint-on-save.sh"
  },
  "rules": {
    "enabled": true,
    "directory": ".cursor/rules",
    "alwaysOn": [
      "format.mdc",
      "multi-ai.mdc",
      "restrictions.mdc"
    ],
    "scoped": {
      "backend.mdc": [
        "api/**",
        "server/**",
        "backend/**",
        "src/server/**",
        "**/*.{php",
        "py",
        "rb",
        "go",
        "java",
        "kt",
        "cs",
        "ex",
        "rs}"
      ],
      "security.mdc": [
        "api/**",
        "server/**",
        "backend/**",
        "src/server/**",
        "**/*.{php",
        "py",
        "rb",
        "go",
        "java",
        "kt",
        "cs",
        "ex",
        "rs}",
        "**/services/**"
      ],
      "testing.mdc": [
        "**/*.{test,spec}.{js,jsx,ts,tsx,py,go,rb,java}",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "seo.mdc": [
        "**/*.{jsx,tsx,js,ts,html,php}",
        "**/seo/**",
        "**/meta/**"
      ],
      "database.mdc": [
        "migrations/**",
        "seeds/**",
        "db/**",
        "prisma/**",
        "alembic/**",
        "**/migrations/**"
      ],
      "ui-styling.mdc": [
        "**/*.{jsx,tsx,js,ts,vue,html,css}"
      ],
      "ui-components.mdc": [
        "**/*.{jsx,tsx,js,ts,vue,html,css}"
      ],
      "transitions.mdc": [
        "**/*.{jsx,tsx,js,ts,vue,html,css}"
      ],
      "project-structure.mdc": [
        "**/*.{jsx,tsx,js,ts,vue,html,css}"
      ]
    },
    "onDemand": {
      "references.mdc": "user gives a reference/inspiration",
      "design-direction.mdc": "intake · P1 design",
      "layout-strategy.mdc": "intake · P1 layout",
      "route-layouts.mdc": "P1 · P2 (read only the R-nn block being built)",
      "concept-domain.mdc": "intake · any feature work (read by F/T id)",
      "phase-plan.mdc": "every session (read only current-phase rows)",
      "implementation-phases.mdc": "session start (framework) + reference/phases/<current>.md",
      "proposal.mdc": "P1 proposal package",
      "forms.mdc": "P2 forms",
      "validation.mdc": "P2 client · P3 server",
      "icons-states.mdc": "P1/P2 states, icons",
      "environments.mdc": "intake topic 9 · /deploy · P1.11 · P5"
    },
    "projectFiles": [
      "concept-domain.mdc",
      "route-layouts.mdc",
      "phase-plan.mdc"
    ],
    "loadMap": "CURSOR.md §6 Load map"
  },
  "skills": {
    "enabled": true,
    "directory": ".cursor/skills"
  },
  "behavior": {
    "alwaysReadClaudeMd": true,
    "claudeMdPath": "CURSOR.md",
    "aiAgnostic": true,
    "multiAiHandoffLog": true,
    "pointerFiles": [
      "AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md",
      ".github/copilot-instructions.md",
      ".windsurfrules"
    ],
    "preferEditOverCreate": true,
    "confirmDestructiveActions": true,
    "autoRunLintOnSave": true,
    "verbosity": "concise",
    "requireProjectIntake": true,
    "installMeansAskAndFill": true,
    "blockFeatureWorkUntilProfileFilled": true,
    "neverRemoveDefaultRules": true,
    "conceptDrivesDomainAndSchema": true,
    "referencesLeaveNoTraceInFiles": true,
    "decisionFlow": "ask-recommend-decide-write-confirm",
    "aiRecommends": true,
    "requireRouteLayouts": true,
    "layoutStrategyOptions": [
      "normal",
      "layout",
      "auto"
    ],
    "frontendFlavors": [
      "react",
      "native"
    ],
    "surfaces": [
      "web",
      "mobile",
      "web + mobile"
    ],
    "webPlusMobileLayout": "layout",
    "proposalPageSize": "letter",
    "proposalPackageInP1": true
  },
  "seo": {
    "enabled": false,
    "schemaOrg": true
  },
  "ignore": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "vendor/**",
    "*.lock",
    ".env",
    ".env.*",
    "!.env.example",
    "!.cursor/templates/**"
  ],
  "templates": {
    "enabled": true,
    "directory": ".cursor/templates",
    "items": [
      "deck-native/index.html",
      "deck-react/",
      "proposal-doc/proposal.html",
      "guide/GUIDE.md",
      "ci/ci.yml",
      "ci/deploy-ftp.yml",
      "ci/deploy-ssh.yml"
    ]
  },
  "migrations": {
    "tool": "TBD",
    "sqlNative": false,
    "commands": {
      "new": "db:new",
      "up": "db:up",
      "down": "db:down",
      "status": "db:status",
      "seed": "db:seed"
    },
    "reference": ".cursor/reference/migrations.md"
  },
  "reference": {
    "directory": ".cursor/reference",
    "note": "Read on demand: components/<group>.md, phases/<P#>.md, layout-patterns.md, migrations.md"
  },
  "environments": {
    "list": [
      "local",
      "staging",
      "production"
    ],
    "branches": {
      "staging": "develop",
      "production": "main"
    },
    "secretsIn": "github-environments",
    "deployMethod": [
      "ftp",
      "ssh"
    ],
    "workflowTemplates": ".cursor/templates/ci/",
    "productionApproval": true
  }
}
